                      00639 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00640 ;                Generate a random value
                      00641 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00642 
0198                  00643 random_value
                      00644 
0198   1512           00645     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0199   1412           00646     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
019A   1492           00647     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00648     
                      00649     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
019B   0811           00650     MOVF    TMR2, W          ; Move Timer 2 value into WREG
019C   3AA3           00651     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
019D   00B4           00652     MOVWF   random_reg      ; Store result in random_reg
                      00653     
                      00654     ; Mask the result to get a value between 0 and 3 (mod 4)
019E   0834           00655     MOVF    random_reg, W   ; Get the value from random_reg
019F   3903           00656     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00657     
                      00658     ; Add 1 to make the range from 1 to 4
01A0   3E01           00659     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00660     
                      00661     ; Return with WREG containing a random value between 1 and 4
01A1   0008           00662     RETURN
