                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
01B0   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
01B1   2196           00077         CALL    xms             ; and wait for display start
01B2   30F0           00078         MOVLW   0F0             ; Mask for select code
