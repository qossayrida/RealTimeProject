014A   1512           00502     BSF     T2CON, TMR2ON    ; Turn on Timer 2
014B   1412           00503     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
014C   1492           00504     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00505     
                      00506     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
014D   0811           00507     MOVF    TMR2, W          ; Move Timer 2 value into WREG
014E   3AA3           00508     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
014F   00B4           00509     MOVWF   random_reg      ; Store result in random_reg
                      00510     
                      00511     ; Mask the result to get a value between 0 and 3 (mod 4)
0150   0834           00512     MOVF    random_reg, W   ; Get the value from random_reg
0151   3903           00513     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00514     
                      00515     ; Add 1 to make the range from 1 to 4
0152   3E01           00516     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00517     
                      00518     ; Return with WREG containing a random value between 1 and 4
0153   0008           00519     RETURN
