                      00483 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00484 ;                       Timer one minute
                      00485 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00486 
0133                  00487 TIMER1_ISR:
0133   1283 1303      00488     BANKSEL  PIR1
                      00489 
0135   100C           00490     BCF     PIR1, 0   ; Clear Timer1 interrupt flag
0136   0AB1           00491     INCF    OVERFLOW_CNT, F ; Increment overflow counter
                      00492 
0137   3075           00493     MOVLW   0x75          ; Check if 2 overflows occurred
                      00494 
0138   0231           00495     SUBWF  OVERFLOW_CNT,0            ; Subtract 10 from W
0139   1D03           00496     BTFSS   STATUS, Z
                      00497 
013A   293F           00498     GOTO    EXIT_ISR       ; If not 2, exit ISR
                      00499 
013B   01B1           00500     CLRF    OVERFLOW_CNT   ; Reset overflow counter
013C   1283 1303      00501     BANKSEL PORTC       ; Select bank 0
013E   1687           00502     BSF PORTC,5      ; Clear LED outputs
                      00503 
                      00504 
013F                  00505 EXIT_ISR:
013F   0009           00506     RETFIE
                      00507 
