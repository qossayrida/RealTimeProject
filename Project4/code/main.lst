                      00472 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00473 ;                Generate a random value
                      00474 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00475 
013A                  00476 random_value
                      00477 
013A   1512           00478     BSF     T2CON, TMR2ON    ; Turn on Timer 2
013B   1412           00479     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
013C   1492           00480     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00481     
                      00482     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
013D   0811           00483     MOVF    TMR2, W          ; Move Timer 2 value into WREG
013E   3AA3           00484     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
013F   00B4           00485     MOVWF   random_reg      ; Store result in random_reg
                      00486     
                      00487     ; Mask the result to get a value between 0 and 3 (mod 4)
0140   0834           00488     MOVF    random_reg, W   ; Get the value from random_reg
0141   3903           00489     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00490     
                      00491     ; Add 1 to make the range from 1 to 4
0142   3E01           00492     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00493     
                      00494     ; Return with WREG containing a random value between 1 and 4
0143   0008           00495     RETURN
