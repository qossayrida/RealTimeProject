                      00635 ;                Generate a random value
                      00636 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00637 
0196                  00638 random_value
                      00639 
0196   1512           00640     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0197   1412           00641     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
0198   1492           00642     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00643     
                      00644     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
0199   0811           00645     MOVF    TMR2, W          ; Move Timer 2 value into WREG
019A   3AA3           00646     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
019B   00B4           00647     MOVWF   random_reg      ; Store result in random_reg
                      00648     
                      00649     ; Mask the result to get a value between 0 and 3 (mod 4)
019C   0834           00650     MOVF    random_reg, W   ; Get the value from random_reg
019D   3903           00651     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00652     
                      00653     ; Add 1 to make the range from 1 to 4
019E   3E01           00654     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00655     
                      00656     ; Return with WREG containing a random value between 1 and 4
019F   0008           00657     RETURN
