                      00048     ; Display "HELLO" on the LCD
000D   3048           00049     MOVLW   'H'
000E   202D           00050     CALL    display_char
000F   3045           00051     MOVLW   'E'
0010   202D           00052     CALL    display_char
0011   304C           00053     MOVLW   'L'
0012   202D           00054     CALL    display_char
0013   304C           00055     MOVLW   'L'
0014   202D           00056     CALL    display_char
0015   304F           00057     MOVLW   'O'
0016   202D           00058     CALL    display_char
                      00059 
0017                  00060 loop
0017   1283 1303      00061     BANKSEL BUTTONS    ; Select bank for BUTTONS
0019   0806           00062     MOVF    BUTTONS, W ; Move BUTTONS state to W
001A   1283 1303      00063     BANKSEL LEDS       ; Select bank for LEDS
                      00064     
                      00065     ; Check each button and toggle corresponding LED
001C   1E00           00066     BTFSS   W, 4       ; Check if RB4 is pressed
001D   2825           00067     GOTO    toggle_RC4 ; If pressed, toggle RC4
001E   1E80           00068     BTFSS   W, 5       ; Check if RB5 is pressed
001F   2827           00069     GOTO    toggle_RC5 ; If pressed, toggle RC5
0020   1F00           00070     BTFSS   W, 6       ; Check if RB6 is pressed
0021   2829           00071     GOTO    toggle_RC6 ; If pressed, toggle RC6
0022   1F80           00072     BTFSS   W, 7       ; Check if RB7 is pressed
0023   282B           00073     GOTO    toggle_RC7 ; If pressed, toggle RC7
                      00074 
0024   2817           00075     GOTO    loop       ; Stay in infinite loop
                      00076 
0025                  00077 toggle_RC4
0025   0687           00078     XORWF   LEDS, F    ; Toggle RC4
0026   2817           00079     GOTO    loop
                      00080 
0027                  00081 toggle_RC5
0027   0687           00082     XORWF   LEDS, F    ; Toggle RC5
0028   2817           00083     GOTO    loop
                      00084 
0029                  00085 toggle_RC6
0029   0687           00086     XORWF   LEDS, F    ; Toggle RC6
002A   2817           00087     GOTO    loop
                      00088 
002B                  00089 toggle_RC7
002B   0687           00090     XORWF   LEDS, F    ; Toggle RC7
002C   2817           00091     GOTO    loop
                      00092 
