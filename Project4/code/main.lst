                      00576 ;                Generate a random value
                      00577 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00578 
0180                  00579 random_value
                      00580 
0180   1512           00581     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0181   1412           00582     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
0182   1492           00583     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00584     
                      00585     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
0183   0811           00586     MOVF    TMR2, W          ; Move Timer 2 value into WREG
0184   3AA3           00587     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
0185   00B4           00588     MOVWF   random_reg      ; Store result in random_reg
                      00589     
                      00590     ; Mask the result to get a value between 0 and 3 (mod 4)
0186   0834           00591     MOVF    random_reg, W   ; Get the value from random_reg
0187   3903           00592     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00593     
                      00594     ; Add 1 to make the range from 1 to 4
0188   3E01           00595     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00596     
                      00597     ; Return with WREG containing a random value between 1 and 4
0189   0008           00598     RETURN
                      00599 
                      00600 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
