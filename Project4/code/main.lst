                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
01C5   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
01C6   21BA           00045         CALL    onems           ; Delay 1ms
01C7   1108           00046         BCF     PORTD,E         ; Reset E low
01C8   21BA           00047         CALL    onems           ; Delay 1ms
01C9   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
