                      00059 
                      00060         ; Print "level 1" or "level 2" based on W
0017   3001           00061     MOVLW   1   ; Load 1 into W for level 1
0018   2031           00062     CALL    print_level
0019   3022           00063     MOVLW   22   ; Load 22 into W for level 22
001A   2031           00064     CALL    print_level
                      00065 
001B                  00066 loop
001B   1283 1303      00067     BANKSEL BUTTONS    ; Select bank for BUTTONS
001D   0806           00068     MOVF    BUTTONS, W ; Move BUTTONS state to W
001E   1283 1303      00069     BANKSEL LEDS       ; Select bank for LEDS
                      00070     
                      00071     ; Check each button and toggle corresponding LED
0020   1E00           00072     BTFSS   W, 4       ; Check if RB4 is pressed
0021   2829           00073     GOTO    toggle_RC4 ; If pressed, toggle RC4
0022   1E80           00074     BTFSS   W, 5       ; Check if RB5 is pressed
0023   282B           00075     GOTO    toggle_RC5 ; If pressed, toggle RC5
0024   1F00           00076     BTFSS   W, 6       ; Check if RB6 is pressed
0025   282D           00077     GOTO    toggle_RC6 ; If pressed, toggle RC6
0026   1F80           00078     BTFSS   W, 7       ; Check if RB7 is pressed
0027   282F           00079     GOTO    toggle_RC7 ; If pressed, toggle RC7
                      00080 
0028   281B           00081     GOTO    loop       ; Stay in infinite loop
                      00082 
0029                  00083 toggle_RC4
