                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
005A   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
005B   204F           00045         CALL    onems           ; Delay 1ms
005C   1108           00046         BCF     PORTD,E         ; Reset E low
