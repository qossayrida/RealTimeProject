                      00472     
                      00473     ; Mask the result to get a value between 0 and 3 (mod 4)
012F   0834           00474     MOVF    random_reg, W   ; Get the value from random_reg
0130   3903           00475     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00476     
                      00477     ; Add 1 to make the range from 1 to 4
0131   3E01           00478     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00479     
                      00480     ; Return with WREG containing a random value between 1 and 4
0132   0008           00481     RETURN
