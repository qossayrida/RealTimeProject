                      00101 ;           Print Level Subroutine
                      00102 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00103 
0031                  00104 print_level
                      00105     ; Display "LEVEL "
0031   304C           00106     MOVLW   'L'
0032   204F           00107     CALL    display_char
0033   3045           00108     MOVLW   'E'
0034   204F           00109     CALL    display_char
0035   3056           00110     MOVLW   'V'
0036   204F           00111     CALL    display_char
0037   3045           00112     MOVLW   'E'
0038   204F           00113     CALL    display_char
0039   304C           00114     MOVLW   'L'
003A   204F           00115     CALL    display_char
003B   3020           00116     MOVLW   ' '          ; Space after "LEVEL"
003C   204F           00117     CALL    display_char
                      00118 
                      00119     ; Convert number in W to ASCII and display
003D   00CD           00120     MOVWF   TEMP         ; Store the level number in TEMP
003E   01CE           00121     CLRF    DIGIT1       ; Clear tens digit counter
                      00122 
003F                  00123 div_loop
003F   3010           00124     MOVLW   10
0040   024D           00125     SUBWF   TEMP, W      ; Subtract 10 from TEMP and store in W
0041   1C03           00126     BTFSS   STATUS, C    ; Skip next instruction if W >= TEMP (no borrow)
0042   2846           00127     GOTO    done_div     ; If borrow occurred, exit loop
0043   0ACE           00128     INCF    DIGIT1, F    ; Increment tens digit counter
0044   0880           00129     MOVF    W, F         ; Move result back to TEMP
0045   283F           00130     GOTO    div_loop     ; Repeat subtraction
                      00131 
0046                  00132 done_div
                      00133     ; TEMP now contains the ones digit, DIGIT1 contains the tens digit
                      00134 
                      00135     ; Display tens digit
0046   084E           00136     MOVF    DIGIT1, W    ; Move tens digit to W
0047   3E30           00137     ADDLW   '0'          ; Convert to ASCII
0048   204F           00138     CALL    display_char ; Display the tens digit
                      00139 
                      00140     ; Display ones digit
0049   084D           00141     MOVF    TEMP, W      ; Move ones digit to W
004A   3E30           00142     ADDLW   '0'          ; Convert to ASCII
004B   204F           00143     CALL    display_char ; Display the ones digit
                      00144 
004C   0008           00145     RETURN
                      00146 
                      00147 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00148 ;                Variables
                      00149 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00150 
004D   3FFF           00151 TEMP        RES     1    ; Temporary storage for level number
004E   3FFF           00152 DIGIT1      RES     1    ; Tens digit
                      00153 
