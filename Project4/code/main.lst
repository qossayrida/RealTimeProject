0050   3020           00141     MOVLW   ' '          ; Space after "LEVEL"
0051   2067           00142     CALL    display_char
                      00143 
                      00144     ; Initialize tens and ones to zero
0052   01E5           00145     CLRF    tens          ; Clear tens register
0053   01E6           00146     CLRF    ones          ; Clear ones register
