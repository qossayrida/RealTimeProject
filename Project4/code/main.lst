                      00053 ;--------------------------------------------------------------
005F   00F5           00054 send    MOVWF   OutCod          ; Store output code
0060   39F0           00055         ANDLW   0F0             ; Clear low nybble
0061   0088           00056         MOVWF   PORTD           ; Output high nybble
0062   18F4           00057         BTFSC   Select,RS       ; Test RS bit
0063   1488           00058         BSF     PORTD,RS        ; and set for data
