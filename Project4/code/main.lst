                      00486     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
013A   0811           00487     MOVF    TMR2, W          ; Move Timer 2 value into WREG
013B   3AA3           00488     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
013C   00B4           00489     MOVWF   random_reg      ; Store result in random_reg
                      00490     
                      00491     ; Mask the result to get a value between 0 and 3 (mod 4)
