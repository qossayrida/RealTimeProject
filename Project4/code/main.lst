                      00586 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00587 ;                Generate a random value
                      00588 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00589 
0187                  00590 random_value
                      00591 
0187   1512           00592     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0188   1412           00593     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
0189   1492           00594     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00595     
                      00596     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
018A   0811           00597     MOVF    TMR2, W          ; Move Timer 2 value into WREG
018B   3AA3           00598     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
018C   00B4           00599     MOVWF   random_reg      ; Store result in random_reg
                      00600     
                      00601     ; Mask the result to get a value between 0 and 3 (mod 4)
018D   0834           00602     MOVF    random_reg, W   ; Get the value from random_reg
018E   3903           00603     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00604     
                      00605     ; Add 1 to make the range from 1 to 4
018F   3E01           00606     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00607     
                      00608     ; Return with WREG containing a random value between 1 and 4
0190   0008           00609     RETURN
