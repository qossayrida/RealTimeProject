01F9   30F9           00024 onems   MOVLW   D'249'          ; Count for 1ms delay 
01FA   00F0           00025                 MOVWF   Timer1          ; Load count    2 + (1 + 1 + 2) * 248 + 1 + 2 + 2
01FB   0000           00026 loop1   NOP                     ; Pad for 4 cycle loop
Message[305]: Using default destination of 1 (file).
01FC   0BF0           00027                 DECFSZ  Timer1          ; Count
01FD   29FB           00028                 GOTO    loop1           ; until Z
01FE   0008           00029                 RETURN                  ; and finish
                      00030 
                      00031 ;--------------------------------------------------------------
