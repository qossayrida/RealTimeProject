LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

005A   0BF1           00037                 DECFSZ  TimerX          ; Repeat X times 
005B   2859           00038                 GOTO    loopX           ; until Z
005C   0008           00039                 RETURN                  ; and finish
                      00040 
                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
005D   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
005E   2052           00045         CALL    onems           ; Delay 1ms
005F   1108           00046         BCF     PORTD,E         ; Reset E low
0060   2052           00047         CALL    onems           ; Delay 1ms
0061   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
0062   00F5           00054 send    MOVWF   OutCod          ; Store output code
0063   39F0           00055         ANDLW   0F0             ; Clear low nybble
0064   0088           00056         MOVWF   PORTD           ; Output high nybble
0065   18F4           00057         BTFSC   Select,RS       ; Test RS bit
0066   1488           00058         BSF     PORTD,RS        ; and set for data
0067   205D           00059         CALL    pulseE          ; and clock display register
0068   2052           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
0069   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
006A   0875           00063         MOVF    OutCod,W        ; Retrieve output code
006B   39F0           00064         ANDLW   0F0             ; Clear low nybble
006C   0088           00065         MOVWF   PORTD           ; Output low nybble
006D   18F4           00066         BTFSC   Select,RS       ; Test RS bit
006E   1488           00067         BSF     PORTD,RS        ; and set for data
006F   205D           00068         CALL    pulseE          ; and clock display register
0070   2052           00069         CALL    onems           ; wait 1ms for display
0071   0008           00070         RETURN                  ; done
                      00071 
                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
0072   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
0073   2058           00077         CALL    xms             ; and wait for display start
0074   30F0           00078         MOVLW   0F0             ; Mask for select code
0075   00F4           00079         MOVWF   Select          ; High nybble not masked
                      00080 
0076   3030           00081         MOVLW   0x30            ; Load initial nibble
0077   0088           00082         MOVWF   PORTD           ; and output it to display
0078   205D           00083         CALL    pulseE          ; Latch initial code
0079   3005           00084         MOVLW   D'5'            ; Set delay 5ms
007A   2058           00085         CALL    xms             ; and wait
007B   205D           00086         CALL    pulseE          ; Latch initial code again
007C   2052           00087         CALL    onems           ; Wait 1ms
007D   205D           00088         CALL    pulseE          ; Latch initial code again
MPASM  5.43                          MAIN.ASM   1-21-2025  20:18:23         PAGE  6


