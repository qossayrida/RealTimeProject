                      00673 
                      00674     INCLUDE "LCDIS.INC"
                      00001 ;--------------------------------------------------------------
                      00002 ;       LCDIS.INC               MPB     19-12-05
                      00003 ;
                      00004 ;       Include file to operate 16x2 LCD display
                      00005 ;       Uses GPR 70 - 75
                      00006 ;       
                      00007 ;       Final version
                      00008 ;--------------------------------------------------------------
                      00009 
  00000070            00010 Timer1  EQU     70              ; 1ms count register
  00000071            00011 TimerX  EQU     71              ; Xms count register
  00000072            00012 Var     EQU     72              ; Output variable
  00000073            00013 Point   EQU     73              ; Program table pointer
  00000074            00014 Select  EQU     74              ; Used to set or clear RS bit
  00000075            00015 OutCod  EQU     75              ; Temp store for output code
                      00016 
  00000001            00017 RS      EQU     1               ; Register select output bit
  00000002            00018 E       EQU     2               ; Enable display input
                      00019 
                      00020 
                      00021 ;--------------------------------------------------------------
                      00022 ;       1ms delay with 1us cycle time (1000 cycles)
                      00023 ;--------------------------------------------------------------
01EF   30F9           00024 onems   MOVLW   D'249'          ; Count for 1ms delay 
01F0   00F0           00025                 MOVWF   Timer1          ; Load count    2 + (1 + 1 + 2) * 248 + 1 + 2 + 2
01F1   0000           00026 loop1   NOP                     ; Pad for 4 cycle loop
Message[305]: Using default destination of 1 (file).
01F2   0BF0           00027                 DECFSZ  Timer1          ; Count
01F3   29F1           00028                 GOTO    loop1           ; until Z
01F4   0008           00029                 RETURN                  ; and finish
                      00030 
                      00031 ;--------------------------------------------------------------
                      00032 ;       Delay Xms
                      00033 ;       Receives count in W, uses Onems
                      00034 ;--------------------------------------------------------------
01F5   00F1           00035 xms             MOVWF   TimerX          ; Count for X ms
01F6   21EF           00036 loopX   CALL    onems           ; Delay 1ms
MPASM  5.43                          MAIN.ASM   1-22-2025  23:47:31         PAGE 15


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

Message[305]: Using default destination of 1 (file).
01F7   0BF1           00037                 DECFSZ  TimerX          ; Repeat X times 
01F8   29F6           00038                 GOTO    loopX           ; until Z
01F9   0008           00039                 RETURN                  ; and finish
                      00040 
                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
01FA   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
01FB   21EF           00045         CALL    onems           ; Delay 1ms
01FC   1108           00046         BCF     PORTD,E         ; Reset E low
01FD   21EF           00047         CALL    onems           ; Delay 1ms
01FE   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
01FF   00F5           00054 send    MOVWF   OutCod          ; Store output code
0200   39F0           00055         ANDLW   0F0             ; Clear low nybble
0201   0088           00056         MOVWF   PORTD           ; Output high nybble
0202   18F4           00057         BTFSC   Select,RS       ; Test RS bit
0203   1488           00058         BSF     PORTD,RS        ; and set for data
0204   21FA           00059         CALL    pulseE          ; and clock display register
0205   21EF           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
0206   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
0207   0875           00063         MOVF    OutCod,W        ; Retrieve output code
0208   39F0           00064         ANDLW   0F0             ; Clear low nybble
0209   0088           00065         MOVWF   PORTD           ; Output low nybble
020A   18F4           00066         BTFSC   Select,RS       ; Test RS bit
020B   1488           00067         BSF     PORTD,RS        ; and set for data
020C   21FA           00068         CALL    pulseE          ; and clock display register
020D   21EF           00069         CALL    onems           ; wait 1ms for display
020E   0008           00070         RETURN                  ; done
                      00071 
                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
020F   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
0210   21F5           00077         CALL    xms             ; and wait for display start
0211   30F0           00078         MOVLW   0F0             ; Mask for select code
0212   00F4           00079         MOVWF   Select          ; High nybble not masked
                      00080 
0213   3030           00081         MOVLW   0x30            ; Load initial nibble
0214   0088           00082         MOVWF   PORTD           ; and output it to display
0215   21FA           00083         CALL    pulseE          ; Latch initial code
0216   3005           00084         MOVLW   D'5'            ; Set delay 5ms
0217   21F5           00085         CALL    xms             ; and wait
0218   21FA           00086         CALL    pulseE          ; Latch initial code again
0219   21EF           00087         CALL    onems           ; Wait 1ms
