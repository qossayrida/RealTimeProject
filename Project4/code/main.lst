01B2   39F0           00055         ANDLW   0F0             ; Clear low nybble
01B3   0088           00056         MOVWF   PORTD           ; Output high nybble
01B4   18F4           00057         BTFSC   Select,RS       ; Test RS bit
01B5   1488           00058         BSF     PORTD,RS        ; and set for data
