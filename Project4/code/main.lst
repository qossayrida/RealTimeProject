LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00007 ;       Final version
                      00008 ;--------------------------------------------------------------
                      00009 
  00000070            00010 Timer1  EQU     70              ; 1ms count register
  00000071            00011 TimerX  EQU     71              ; Xms count register
  00000072            00012 Var     EQU     72              ; Output variable
  00000073            00013 Point   EQU     73              ; Program table pointer
  00000074            00014 Select  EQU     74              ; Used to set or clear RS bit
  00000075            00015 OutCod  EQU     75              ; Temp store for output code
                      00016 
  00000001            00017 RS      EQU     1               ; Register select output bit
  00000002            00018 E       EQU     2               ; Enable display input
                      00019 
                      00020 
                      00021 ;--------------------------------------------------------------
                      00022 ;       1ms delay with 1us cycle time (1000 cycles)
                      00023 ;--------------------------------------------------------------
01BC   30F9           00024 onems   MOVLW   D'249'          ; Count for 1ms delay 
01BD   00F0           00025                 MOVWF   Timer1          ; Load count    2 + (1 + 1 + 2) * 248 + 1 + 2 + 2
01BE   0000           00026 loop1   NOP                     ; Pad for 4 cycle loop
Message[305]: Using default destination of 1 (file).
01BF   0BF0           00027                 DECFSZ  Timer1          ; Count
01C0   29BE           00028                 GOTO    loop1           ; until Z
01C1   0008           00029                 RETURN                  ; and finish
                      00030 
                      00031 ;--------------------------------------------------------------
                      00032 ;       Delay Xms
                      00033 ;       Receives count in W, uses Onems
                      00034 ;--------------------------------------------------------------
01C2   00F1           00035 xms             MOVWF   TimerX          ; Count for X ms
01C3   21BC           00036 loopX   CALL    onems           ; Delay 1ms
Message[305]: Using default destination of 1 (file).
01C4   0BF1           00037                 DECFSZ  TimerX          ; Repeat X times 
01C5   29C3           00038                 GOTO    loopX           ; until Z
01C6   0008           00039                 RETURN                  ; and finish
                      00040 
                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
01C7   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
01C8   21BC           00045         CALL    onems           ; Delay 1ms
01C9   1108           00046         BCF     PORTD,E         ; Reset E low
01CA   21BC           00047         CALL    onems           ; Delay 1ms
01CB   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
01CC   00F5           00054 send    MOVWF   OutCod          ; Store output code
01CD   39F0           00055         ANDLW   0F0             ; Clear low nybble
01CE   0088           00056         MOVWF   PORTD           ; Output high nybble
01CF   18F4           00057         BTFSC   Select,RS       ; Test RS bit
MPASM  5.43                          MAIN.ASM   1-24-2025  15:50:58         PAGE 16


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

01D0   1488           00058         BSF     PORTD,RS        ; and set for data
01D1   21C7           00059         CALL    pulseE          ; and clock display register
01D2   21BC           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
01D3   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
01D4   0875           00063         MOVF    OutCod,W        ; Retrieve output code
01D5   39F0           00064         ANDLW   0F0             ; Clear low nybble
01D6   0088           00065         MOVWF   PORTD           ; Output low nybble
01D7   18F4           00066         BTFSC   Select,RS       ; Test RS bit
01D8   1488           00067         BSF     PORTD,RS        ; and set for data
01D9   21C7           00068         CALL    pulseE          ; and clock display register
01DA   21BC           00069         CALL    onems           ; wait 1ms for display
