                      00630 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00631 
0191                  00632 random_value
                      00633 
0191   1512           00634     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0192   1412           00635     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
0193   1492           00636     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00637     
                      00638     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
0194   0811           00639     MOVF    TMR2, W          ; Move Timer 2 value into WREG
0195   3AA3           00640     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
0196   00B4           00641     MOVWF   random_reg      ; Store result in random_reg
                      00642     
                      00643     ; Mask the result to get a value between 0 and 3 (mod 4)
0197   0834           00644     MOVF    random_reg, W   ; Get the value from random_reg
0198   3903           00645     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00646     
                      00647     ; Add 1 to make the range from 1 to 4
0199   3E01           00648     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00649     
                      00650     ; Return with WREG containing a random value between 1 and 4
019A   0008           00651     RETURN
