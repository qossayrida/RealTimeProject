                      00494     
                      00495     ; Add 1 to make the range from 1 to 4
013F   3E01           00496     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00497     
                      00498     ; Return with WREG containing a random value between 1 and 4
0140   0008           00499     RETURN
