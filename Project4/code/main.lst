LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00016 
  00000001            00017 RS      EQU     1               ; Register select output bit
  00000002            00018 E       EQU     2               ; Enable display input
                      00019 
                      00020 
                      00021 ;--------------------------------------------------------------
                      00022 ;       1ms delay with 1us cycle time (1000 cycles)
                      00023 ;--------------------------------------------------------------
0017   30F9           00024 onems   MOVLW   D'249'          ; Count for 1ms delay 
0018   00F0           00025                 MOVWF   Timer1          ; Load count    2 + (1 + 1 + 2) * 248 + 1 + 2 + 2
0019   0000           00026 loop1   NOP                     ; Pad for 4 cycle loop
Message[305]: Using default destination of 1 (file).
001A   0BF0           00027                 DECFSZ  Timer1          ; Count
001B   2819           00028                 GOTO    loop1           ; until Z
001C   0008           00029                 RETURN                  ; and finish
                      00030 
                      00031 ;--------------------------------------------------------------
                      00032 ;       Delay Xms
                      00033 ;       Receives count in W, uses Onems
                      00034 ;--------------------------------------------------------------
001D   00F1           00035 xms             MOVWF   TimerX          ; Count for X ms
001E   2017           00036 loopX   CALL    onems           ; Delay 1ms
Message[305]: Using default destination of 1 (file).
001F   0BF1           00037                 DECFSZ  TimerX          ; Repeat X times 
0020   281E           00038                 GOTO    loopX           ; until Z
0021   0008           00039                 RETURN                  ; and finish
                      00040 
                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
0022   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
0023   2017           00045         CALL    onems           ; Delay 1ms
0024   1108           00046         BCF     PORTD,E         ; Reset E low
0025   2017           00047         CALL    onems           ; Delay 1ms
0026   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
0027   00F5           00054 send    MOVWF   OutCod          ; Store output code
0028   39F0           00055         ANDLW   0F0             ; Clear low nybble
0029   0088           00056         MOVWF   PORTD           ; Output high nybble
002A   18F4           00057         BTFSC   Select,RS       ; Test RS bit
002B   1488           00058         BSF     PORTD,RS        ; and set for data
002C   2022           00059         CALL    pulseE          ; and clock display register
002D   2017           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
002E   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
002F   0875           00063         MOVF    OutCod,W        ; Retrieve output code
0030   39F0           00064         ANDLW   0F0             ; Clear low nybble
0031   0088           00065         MOVWF   PORTD           ; Output low nybble
MPASM  5.43                          MAIN.ASM   1-21-2025  17:44:25         PAGE  4


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0032   18F4           00066         BTFSC   Select,RS       ; Test RS bit
0033   1488           00067         BSF     PORTD,RS        ; and set for data
0034   2022           00068         CALL    pulseE          ; and clock display register
0035   2017           00069         CALL    onems           ; wait 1ms for display
0036   0008           00070         RETURN                  ; done
                      00071 
                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
0037   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
0038   201D           00077         CALL    xms             ; and wait for display start
0039   30F0           00078         MOVLW   0F0             ; Mask for select code
003A   00F4           00079         MOVWF   Select          ; High nybble not masked
                      00080 
003B   3030           00081         MOVLW   0x30            ; Load initial nibble
003C   0088           00082         MOVWF   PORTD           ; and output it to display
003D   2022           00083         CALL    pulseE          ; Latch initial code
003E   3005           00084         MOVLW   D'5'            ; Set delay 5ms
003F   201D           00085         CALL    xms             ; and wait
0040   2022           00086         CALL    pulseE          ; Latch initial code again
0041   2017           00087         CALL    onems           ; Wait 1ms
0042   2022           00088         CALL    pulseE          ; Latch initial code again
0043   1208           00089         BCF     PORTD,4         ; Set 4-bit mode
0044   2022           00090         CALL    pulseE          ; Latch it
                      00091         
0045   3028           00092         MOVLW   0x28            ; Set 4-bit mode, 2 lines
0046   2027           00093         CALL    send            ; and send code
0047   3008           00094         MOVLW   0x08            ; Switch off display
0048   2027           00095         CALL    send            ; and send code
0049   3001           00096         MOVLW   0x01            ; Code to clear display
004A   2027           00097         CALL    send            ; and send code
004B   3006           00098         MOVLW   0x06            ; Enable cursor auto inc  
004C   2027           00099         CALL    send            ; and send code
004D   3080           00100         MOVLW   0x80            ; Zero display address
004E   2027           00101         CALL    send            ; and send code
004F   300C           00102         MOVLW   0x0C            ; Turn on display  
0050   2027           00103         CALL    send            ; and send code
                      00104 
0051   0008           00105         RETURN                  ; Done
                      00106 
