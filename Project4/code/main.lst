                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
006E   00F5           00054 send    MOVWF   OutCod          ; Store output code
006F   39F0           00055         ANDLW   0F0             ; Clear low nybble
0070   0088           00056         MOVWF   PORTD           ; Output high nybble
0071   18F4           00057         BTFSC   Select,RS       ; Test RS bit
0072   1488           00058         BSF     PORTD,RS        ; and set for data
0073   2069           00059         CALL    pulseE          ; and clock display register
0074   205E           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
0075   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
0076   0875           00063         MOVF    OutCod,W        ; Retrieve output code
0077   39F0           00064         ANDLW   0F0             ; Clear low nybble
0078   0088           00065         MOVWF   PORTD           ; Output low nybble
0079   18F4           00066         BTFSC   Select,RS       ; Test RS bit
007A   1488           00067         BSF     PORTD,RS        ; and set for data
007B   2069           00068         CALL    pulseE          ; and clock display register
007C   205E           00069         CALL    onems           ; wait 1ms for display
007D   0008           00070         RETURN                  ; done
                      00071 
                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
007E   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
007F   2064           00077         CALL    xms             ; and wait for display start
0080   30F0           00078         MOVLW   0F0             ; Mask for select code
0081   00F4           00079         MOVWF   Select          ; High nybble not masked
                      00080 
0082   3030           00081         MOVLW   0x30            ; Load initial nibble
0083   0088           00082         MOVWF   PORTD           ; and output it to display
0084   2069           00083         CALL    pulseE          ; Latch initial code
0085   3005           00084         MOVLW   D'5'            ; Set delay 5ms
0086   2064           00085         CALL    xms             ; and wait
0087   2069           00086         CALL    pulseE          ; Latch initial code again
0088   205E           00087         CALL    onems           ; Wait 1ms
0089   2069           00088         CALL    pulseE          ; Latch initial code again
008A   1208           00089         BCF     PORTD,4         ; Set 4-bit mode
008B   2069           00090         CALL    pulseE          ; Latch it
                      00091         
008C   3028           00092         MOVLW   0x28            ; Set 4-bit mode, 2 lines
008D   206E           00093         CALL    send            ; and send code
008E   3008           00094         MOVLW   0x08            ; Switch off display
008F   206E           00095         CALL    send            ; and send code
0090   3001           00096         MOVLW   0x01            ; Code to clear display
0091   206E           00097         CALL    send            ; and send code
0092   3006           00098         MOVLW   0x06            ; Enable cursor auto inc  
0093   206E           00099         CALL    send            ; and send code
0094   3080           00100         MOVLW   0x80            ; Zero display address
