0191   1512           00635     BSF     T2CON, TMR2ON    ; Turn on Timer 2
0192   1412           00636     BSF     T2CON, T2CKPS0   ; Prescaler setting (e.g., 1:4, modify as needed)
0193   1492           00637     BSF     T2CON, T2CKPS1   ; Prescaler setting (e.g., 1:4, modify as needed)
                      00638     
                      00639     ; Wait for Timer 2 to overflow (set Timer 2 to generate a pseudo-random value)
0194   0811           00640     MOVF    TMR2, W          ; Move Timer 2 value into WREG
0195   3AA3           00641     XORLW   0xA3            ; XOR WREG with some constant (e.g., 0xA3) to introduce randomness
0196   00B4           00642     MOVWF   random_reg      ; Store result in random_reg
                      00643     
                      00644     ; Mask the result to get a value between 0 and 3 (mod 4)
0197   0834           00645     MOVF    random_reg, W   ; Get the value from random_reg
0198   3903           00646     ANDLW   0x03            ; Mask the lower 2 bits (values from 0 to 3)
                      00647     
                      00648     ; Add 1 to make the range from 1 to 4
0199   3E01           00649     ADDLW   0x01            ; Add 1 to the result (range now 1 to 4)
                      00650     
                      00651     ; Return with WREG containing a random value between 1 and 4
019A   0008           00652     RETURN
