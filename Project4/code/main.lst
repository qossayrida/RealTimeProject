01BC   1208           00089         BCF     PORTD,4         ; Set 4-bit mode
01BD   219B           00090         CALL    pulseE          ; Latch it
                      00091         
01BE   3028           00092         MOVLW   0x28            ; Set 4-bit mode, 2 lines
