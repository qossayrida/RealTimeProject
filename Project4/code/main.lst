022A                  00830 random_value
                      00831     ; Initialize LFSR if not already initialized
022A   1283 1303      00832     BANKSEL random_reg
022C   0834           00833     MOVF    random_reg, W      ; Load the current random value
022D   1903           00834     BTFSC   STATUS, Z          ; Check if random_reg is zero (initial state)
022E   3001           00835     MOVLW   0x01               ; If zero, seed the LFSR with a non-zero value
022F   00B4           00836     MOVWF   random_reg         ; Store the seed or current value
                      00837 
                      00838     ; Perform LFSR operation (16-bit LFSR example)
0230   0D34           00839     RLF     random_reg, W      ; Rotate left through carry
0231   0634           00840     XORWF   random_reg, W      ; XOR with the current value
0232   3901           00841     ANDLW   0x01               ; Mask to get the feedback bit
0233   0DB4           00842     RLF     random_reg, F      ; Rotate left and incorporate feedback bit
                      00843 
                      00844     ; Mask the result to get a value between 0 and 3 (mod 4)
0234   0834           00845     MOVF    random_reg, W      ; Get the value from random_reg
0235   3903           00846     ANDLW   0x03               ; Mask the lower 2 bits (values from 0 to 3)
                      00847 
                      00848     ; Add 1 to make the range from 1 to 4
0236   3E01           00849     ADDLW   0x01               ; Add 1 to the result (range now 1 to 4)
                      00850 
                      00851     ; Return with WREG containing a random value between 1 and 4
0237   0008           00852     RETURN
