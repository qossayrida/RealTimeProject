0086   3006           00098         MOVLW   0x06            ; Enable cursor auto inc  
0087   2062           00099         CALL    send            ; and send code
0088   3080           00100         MOVLW   0x80            ; Zero display address
0089   2062           00101         CALL    send            ; and send code
008A   300C           00102         MOVLW   0x0C            ; Turn on display  
008B   2062           00103         CALL    send            ; and send code
