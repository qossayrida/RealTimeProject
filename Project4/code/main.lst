                      00048     ; Display "HELLO" on the LCD
000D   3048           00049     MOVLW   'H'
000E   204F           00050     CALL    display_char
000F   3045           00051     MOVLW   'E'
0010   204F           00052     CALL    display_char
0011   304C           00053     MOVLW   'L'
