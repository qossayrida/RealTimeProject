0143   0230           00518     SUBWF   COUNTER,0      ; Subtract 10 from W
0144   1D03           00519     BTFSS   STATUS, Z     
0145   294B           00520     GOTO    Exit_ISR       ; If not, exit ISR
0146   01B0           00521     CLRF    COUNTER        ; Reset counter after 31 overflows (2 seconds)
0147   1687           00522         BSF PORTC,5      ; Clear LED outputs
