                      00622 
0196   0231           00623     SUBWF  OVERFLOW_CNT,0            ; Subtract 10 from W
0197   1D03           00624     BTFSS   STATUS, Z
0198   299E           00625     GOTO    EXIT_ISR       ; If not 2, exit ISR
0199   01B1           00626     CLRF    OVERFLOW_CNT   ; Reset overflow counter
                      00627     
