                      00603 
018A                  00604 TIMER1_ISR:
018A   1283 1303      00605     BANKSEL  PIR1
                      00606 
018C   100C           00607     BCF     PIR1, 0   ; Clear Timer1 interrupt flag
018D   0AB1           00608     INCF    OVERFLOW_CNT, F ; Increment overflow counter
                      00609 
018E   3075           00610     MOVLW   0x75          ; Check if 2 overflows occurred
                      00611 
018F   0231           00612     SUBWF  OVERFLOW_CNT,0            ; Subtract 10 from W
0190   1D03           00613     BTFSS   STATUS, Z
0191   2997           00614     GOTO    EXIT_ISR       ; If not 2, exit ISR
0192   01B1           00615     CLRF    OVERFLOW_CNT   ; Reset overflow counter
                      00616     
                      00617 
0193   3020           00618         MOVLW   0x20
0194   1283 1303      00619     BANKSEL LEDS            ; Select bank for LEDS
0196   0687           00620         XORWF   LEDS, F
                      00621 
                      00622 
0197                  00623 EXIT_ISR:
0197   0009           00624     RETFIE
