                      00091         
0080   3028           00092         MOVLW   0x28            ; Set 4-bit mode, 2 lines
0081   2062           00093         CALL    send            ; and send code
0082   3008           00094         MOVLW   0x08            ; Switch off display
0083   2062           00095         CALL    send            ; and send code
0084   3001           00096         MOVLW   0x01            ; Code to clear display
