                      00129 
                      00130     ; Display "LEVEL "
0046   304C           00131     MOVLW   'L'
0047   2067           00132     CALL    display_char
0048   3045           00133     MOVLW   'E'
0049   2067           00134     CALL    display_char
004A   3056           00135     MOVLW   'V'
