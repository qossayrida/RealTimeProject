                      00660 ;       Include LCD driver routine
                      00661 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                      00662 
                      00663     INCLUDE "LCDIS.INC"
                      00001 ;--------------------------------------------------------------
                      00002 ;       LCDIS.INC               MPB     19-12-05
                      00003 ;
                      00004 ;       Include file to operate 16x2 LCD display
                      00005 ;       Uses GPR 70 - 75
                      00006 ;       
                      00007 ;       Final version
                      00008 ;--------------------------------------------------------------
                      00009 
  00000070            00010 Timer1  EQU     70              ; 1ms count register
  00000071            00011 TimerX  EQU     71              ; Xms count register
  00000072            00012 Var     EQU     72              ; Output variable
  00000073            00013 Point   EQU     73              ; Program table pointer
  00000074            00014 Select  EQU     74              ; Used to set or clear RS bit
  00000075            00015 OutCod  EQU     75              ; Temp store for output code
                      00016 
  00000001            00017 RS      EQU     1               ; Register select output bit
  00000002            00018 E       EQU     2               ; Enable display input
                      00019 
                      00020 
                      00021 ;--------------------------------------------------------------
                      00022 ;       1ms delay with 1us cycle time (1000 cycles)
                      00023 ;--------------------------------------------------------------
01E8   30F9           00024 onems   MOVLW   D'249'          ; Count for 1ms delay 
01E9   00F0           00025                 MOVWF   Timer1          ; Load count    2 + (1 + 1 + 2) * 248 + 1 + 2 + 2
01EA   0000           00026 loop1   NOP                     ; Pad for 4 cycle loop
Message[305]: Using default destination of 1 (file).
01EB   0BF0           00027                 DECFSZ  Timer1          ; Count
01EC   29EA           00028                 GOTO    loop1           ; until Z
01ED   0008           00029                 RETURN                  ; and finish
                      00030 
                      00031 ;--------------------------------------------------------------
                      00032 ;       Delay Xms
                      00033 ;       Receives count in W, uses Onems
                      00034 ;--------------------------------------------------------------
01EE   00F1           00035 xms             MOVWF   TimerX          ; Count for X ms
01EF   21E8           00036 loopX   CALL    onems           ; Delay 1ms
Message[305]: Using default destination of 1 (file).
01F0   0BF1           00037                 DECFSZ  TimerX          ; Repeat X times 
01F1   29EF           00038                 GOTO    loopX           ; until Z
01F2   0008           00039                 RETURN                  ; and finish
                      00040 
                      00041 ;--------------------------------------------------------------
                      00042 ;       Generate data/command clock siganl E
                      00043 ;--------------------------------------------------------------
01F3   1508           00044 pulseE  BSF     PORTD,E         ; Set E high
01F4   21E8           00045         CALL    onems           ; Delay 1ms
01F5   1108           00046         BCF     PORTD,E         ; Reset E low
01F6   21E8           00047         CALL    onems           ; Delay 1ms
MPASM  5.43                          MAIN.ASM   1-22-2025  23:25:23         PAGE 15


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

01F7   0008           00048         RETURN                  ; done
                      00049 
                      00050 ;--------------------------------------------------------------
                      00051 ;       Send a command byte in two nibbles from RB4 - RB7
                      00052 ;       Receives command in W, uses PulseE and Onems
                      00053 ;--------------------------------------------------------------
01F8   00F5           00054 send    MOVWF   OutCod          ; Store output code
01F9   39F0           00055         ANDLW   0F0             ; Clear low nybble
01FA   0088           00056         MOVWF   PORTD           ; Output high nybble
01FB   18F4           00057         BTFSC   Select,RS       ; Test RS bit
01FC   1488           00058         BSF     PORTD,RS        ; and set for data
01FD   21F3           00059         CALL    pulseE          ; and clock display register
01FE   21E8           00060         CALL    onems           ; wait 1ms for display
                      00061 
Message[305]: Using default destination of 1 (file).
01FF   0EF5           00062         SWAPF   OutCod          ; Swap low and high nybbles 
0200   0875           00063         MOVF    OutCod,W        ; Retrieve output code
0201   39F0           00064         ANDLW   0F0             ; Clear low nybble
0202   0088           00065         MOVWF   PORTD           ; Output low nybble
0203   18F4           00066         BTFSC   Select,RS       ; Test RS bit
0204   1488           00067         BSF     PORTD,RS        ; and set for data
0205   21F3           00068         CALL    pulseE          ; and clock display register
0206   21E8           00069         CALL    onems           ; wait 1ms for display
0207   0008           00070         RETURN                  ; done
                      00071 
                      00072 ;--------------------------------------------------------------
                      00073 ;       Initialise the display
                      00074 ;       Uses Send
                      00075 ;--------------------------------------------------------------
0208   3064           00076 inid    MOVLW   D'100'          ; Load count for 100ms delay
0209   21EE           00077         CALL    xms             ; and wait for display start
020A   30F0           00078         MOVLW   0F0             ; Mask for select code
020B   00F4           00079         MOVWF   Select          ; High nybble not masked
                      00080 
020C   3030           00081         MOVLW   0x30            ; Load initial nibble
020D   0088           00082         MOVWF   PORTD           ; and output it to display
020E   21F3           00083         CALL    pulseE          ; Latch initial code
020F   3005           00084         MOVLW   D'5'            ; Set delay 5ms
0210   21EE           00085         CALL    xms             ; and wait
0211   21F3           00086         CALL    pulseE          ; Latch initial code again
0212   21E8           00087         CALL    onems           ; Wait 1ms
0213   21F3           00088         CALL    pulseE          ; Latch initial code again
0214   1208           00089         BCF     PORTD,4         ; Set 4-bit mode
0215   21F3           00090         CALL    pulseE          ; Latch it
                      00091         
0216   3028           00092         MOVLW   0x28            ; Set 4-bit mode, 2 lines
0217   21F8           00093         CALL    send            ; and send code
0218   3008           00094         MOVLW   0x08            ; Switch off display
0219   21F8           00095         CALL    send            ; and send code
021A   3001           00096         MOVLW   0x01            ; Code to clear display
021B   21F8           00097         CALL    send            ; and send code
021C   3006           00098         MOVLW   0x06            ; Enable cursor auto inc  
021D   21F8           00099         CALL    send            ; and send code
